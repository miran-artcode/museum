{
  "name": "museum",
  "version": "1.0.0",
  "description": "고등학교 2학년 미술 8차시 단원 「실재한 적 없는 유물 이미지로 구성한 허구의 아카이브 전시」의 수업 자료와 학생 기록지, 교사 대시보드를 담은 웹 애플리케이션입니다.",
  "main": "src-fb.js",
  "scripts": {
    "build": "esbuild src-app.jsx --bundle --jsx=automatic --loader:.jsx=jsx --minify --format=iife --charset=utf8 --outfile=public/app.js && esbuild src-ar3d.js --bundle --minify --format=iife --outfile=public/ar3d.js",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting",
    "test": "node --test src-assess-core.test.mjs src-quiz-core.test.mjs src-ws-sync.test.mjs src-asks-core.test.mjs src-access-core.test.mjs src-ar-expo.test.mjs src-csv.test.mjs src-pid.test.mjs",
    "view": "node scripts/bank-view.mjs",
    "pilot": "node scripts/pilot-sheet.mjs",
    "backup": "node scripts/backup-firestore.mjs",
    "restore": "node scripts/restore-worksheet.mjs",
    "restore:bank": "node scripts/quiz-bank-restore.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miran-artcode/museum.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/miran-artcode/museum/issues"
  },
  "homepage": "https://github.com/miran-artcode/museum#readme",
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "esbuild": "^0.28.2",
    "firebase": "^12.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.183.2"
  }
}
