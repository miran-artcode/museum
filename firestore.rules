rules_version = '2';

// 허구의 아카이브 학급 기록실 접근 규칙
// 계정 체계: 학생 = {학번}@museum.class / 교사 = teacher@museum.class
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인 확인은 이메일 도메인까지 본다. 이메일·비밀번호 가입은 도메인을 제한하지 않으므로
    // 도메인을 안 보면 teacher@다른곳 계정으로 uid()가 teacher가 되어 교사 권한이 열린다 (2026-09-17 보안 검토 1번).
    function emailParts() {
      return request.auth.token.email.split('@');
    }
    function signedIn() {
      return request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email is string
          && emailParts().size() == 2
          && emailParts()[1] == 'museum.class';
    }
    // 로그인한 계정의 아이디 (학번 또는 teacher)
    function uid() {
      return emailParts()[0];
    }
    function isTeacher() {
      return signedIn() && uid() == 'teacher';
    }
    function isOwner(id) {
      return signedIn() && uid() == id;
    }
    // 문서 바이트 크기를 재는 함수는 규칙 언어에 없다(Firestore 자체 상한 1 MiB만 적용된다).
    // 값이 문자열인 media만 길이로 잰다.
    function mediaSizeOk() {
      return request.resource.data.v is string && request.resource.data.v.size() < 1000000;
    }
    // 학급 설정 문서의 v (없으면 빈 맵)
    function cfgV() {
      return exists(/databases/$(database)/documents/meta/config)
          ? get(/databases/$(database)/documents/meta/config).data.get('v', {}) : {};
    }
    // 명단 잠금: 교사가 켜면(설정 4) 명부에 없는 학번은 명부 문서를 만들 수 없다
    function rosterLocked() {
      return cfgV().get('rosterLock', false) == true;
    }
    // 명부에 있는 학번인가. 학생이 새 문서를 만들 때 요구해 명부 밖 계정의 문서 남발을 막는다
    function enrolled(id) {
      return exists(/databases/$(database)/documents/students/$(id));
    }
    // 학생이 자기 명부 문서에 쓰는 필드는 별명(12자 이내)과 시각뿐
    function studentNickOk() {
      return request.resource.data.get('nick', '') is string && request.resource.data.get('nick', '').size() <= 12;
    }

    // 차시 공개 설정: 로그인한 사람은 읽고, 교사만 쓴다
    match /meta/{docId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // 학생 명부(학번과 별명만): 로그인한 사람은 읽고, 본인과 교사만 쓴다
    match /students/{sid} {
      allow read: if signedIn();
      allow create: if isTeacher()
                    || (isOwner(sid) && !rosterLocked() && studentNickOk()
                        && request.resource.data.keys().hasOnly(['nick', 'updatedAt']));
      allow update: if isTeacher()
                    || (isOwner(sid) && studentNickOk()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick', 'updatedAt']));
      allow delete: if isTeacher();
    }

    // 창작 기록지: 본인과 교사만 읽는다. 쓰기는 본인, 그리고 학생 관리(학번 이관·전시 내리기)를 위한 교사
    match /worksheets/{sid} {
      allow read: if isOwner(sid) || isTeacher();
      allow create: if isTeacher() || (isOwner(sid) && enrolled(sid));
      allow update: if isOwner(sid) || isTeacher();
      allow delete: if isTeacher();
    }

    // 기록지 시점 사본: 문서 이름이 {학번}_{시간대}라 앞부분으로 소유자를 판별한다.
    // 학생 화면의 자동 저장이 만들고, 교사가 「관리」 탭에서 읽어 그 시점으로 되돌린다 (src-ws-history.jsx)
    // 교사 화면은 v.sid로 조회하므로 학생 쓰기는 v.sid가 자기 학번이어야 한다 (다른 학생의 목록에 가짜 사본을 끼워 넣지 못하게)
    function wshSidOk() {
      return request.resource.data.get('v', {}).get('sid', '') == uid();
    }
    match /wsHistory/{docId} {
      allow read: if isTeacher() || (signedIn() && docId.split('_')[0] == uid());
      allow create: if isTeacher() || (signedIn() && docId.split('_')[0] == uid() && enrolled(uid()) && wshSidOk());
      allow update: if isTeacher() || (signedIn() && docId.split('_')[0] == uid() && wshSidOk());
      allow delete: if isTeacher();
    }

    // 채점 기록: 본인은 읽기만, 쓰기는 교사만
    match /grades/{sid} {
      allow read: if isOwner(sid) || isTeacher();
      allow write: if isTeacher();
    }

    // 사전·사후 창의성 설문: 본인과 교사만 읽고, 본인만 쓴다 (연구용 수집 데이터)
    match /surveys/{sid} {
      allow read: if isOwner(sid) || isTeacher();
      allow create: if isOwner(sid) && enrolled(sid);
      allow update: if isOwner(sid);
      allow delete: if isTeacher();
    }

    // 사진·음성: 문서 이름이 {소유자}_{필드}_{시각} 형식이므로 앞부분으로 소유자를 판별한다
    // 교사 쓰기는 학번 이관 때 미디어를 새 소유자 이름으로 복사하기 위한 것
    // 교사가 「수업 편집」에서 올린 수업 자료 그림도 teacher_ 로 시작하는 이름으로 여기 들어간다
    // 기록지는 본인·교사만 읽지만 그 안의 사진·음성·영상은 전시를 위해 문서 이름을 아는 사람이 읽는다.
    // 컬렉션 전체 목록(list)은 교사만: 학생 화면은 문서 이름으로만 읽으므로 목록이 열리면 학급 전체 미디어를 내려받을 수 있다.
    match /media/{mediaId} {
      allow get: if signedIn();
      allow list: if isTeacher();
      allow create: if isTeacher() || (signedIn() && mediaId.split('_')[0] == uid() && enrolled(uid()) && mediaSizeOk());
      allow update: if signedIn() && (mediaId.split('_')[0] == uid() || isTeacher()) && mediaSizeOk();
      allow delete: if signedIn() && (mediaId.split('_')[0] == uid() || isTeacher());
    }

    // 상호평가(쌍대비교) — 최종 작품 스냅샷. 비교와 결과 화면을 위해 학급 전체가 읽는다.
    // 문서 id가 학번이라 표시상 익명·저장상 준익명이다 (설계서 §4.6).
    // 확정(locked)된 제출은 학생이 고칠 수 없다 — 비교 도중 작품이 바뀌면 판정자마다 다른 작품을 본 것이 된다.
    // 해제는 교사만 한다 (locked:false를 써 넣으면 학생이 다시 고쳐 제출할 수 있다).
    match /submissions/{sid} {
      allow read: if signedIn();
      allow create: if isTeacher() || (isOwner(sid) && enrolled(sid));
      allow update: if isTeacher() || (isOwner(sid) && resource.data.get('v', {}).get('locked', false) != true);
      allow delete: if isTeacher();
    }

    // 상호평가 — 자기평가·판정·집계 결과. 본인과 교사만 읽는다.
    // 교사는 무엇이든 쓴다(집계 결과 result 포함). 학생은 자기 문서의 self·judge만 쓰고,
    // result는 만들지도 바꾸지도 못하며, 제출을 마친 자기평가 ①은 다시 고칠 수 없다(사전·사후 동일성).
    function assessV(res) {
      return res.data.get('v', {});
    }
    function s1Kept() {
      let before = assessV(resource).get('self', {}).get('s1', {});
      let after = assessV(request.resource).get('self', {}).get('s1', {});
      return before.get('submittedAt', null) == null || after == before;
    }
    match /assess/{sid} {
      allow read: if isOwner(sid) || isTeacher();
      allow delete: if isTeacher();
      allow create, update: if isTeacher();
      allow create: if isOwner(sid) && enrolled(sid) && !('result' in assessV(request.resource));
      allow update: if isOwner(sid)
                    && !assessV(request.resource).diff(assessV(resource)).affectedKeys().hasAny(['result'])
                    && s1Kept();
    }

    // 적응형 쪽지시험 — 문항 은행(공개부)·정답 키·응시 기록 (쪽지시험_구현_근거.md §8, src-quiz-core.mjs 계약)
    // 은행 공개부에는 정답이 없고(keyHash만) 교사가 시험을 연 뒤(stage != closed)에만 학생이 읽는다. 정답 키는 교사만 읽고 쓴다.
    // 응시 문서 quiz/{학번}은 본인·교사만 읽는다. 학생은 시작 마감 안에 startedAt을 서버 시각으로 만들고,
    // 끝내기(finishedAt) 전까지, 제한 시간(배수·보전·추가·전체 정지 + 60초 유예) 안에서만 진행 필드를 고친다.
    // 만들 때 v.sid는 문서 이름, status는 running, blocks는 비어 있고, lockedAt은 null이어야 한다.
    // 시작 시각·반·seed·은행 버전과 교사 필드(pausedTotalSec·extraSec·result 등)는 학생이 바꾸지 못하고,
    // 제출한 블록(blocks)·이미 연 블록의 문항(served)은 그대로여야 하며, 이벤트 목록(events)은 앞부분이 그대로인 채
    // 늘어나기만 하고(추가 전용), 경고 수(warn)·잠금 수(lock.count)는 줄지 않는다.
    // 잠금 시각(lockedAt)은 그대로 두거나 서버 시각으로만 쓸 수 있다(교사 해제의 보전 시간이 이 값에서 나온다).
    // 시간이 끝난 뒤에는 마무리 필드(status·finishedAt·clientScore·events·lock·warn·cur)만 쓸 수 있다.
    function quizV(res) {
      return res.data.get('v', {});
    }
    function quizCfg() {
      return cfgV().get('quiz', {});
    }
    function quizStage() {
      return quizCfg().get('stage', 'closed');
    }
    // 교사만 쓰는 v 안의 키
    function quizTeacherKeys() {
      return ['pausedTotalSec', 'extraSec', 'extraReason', 'falsePos', 'note', 'resumeOk', 'result'];
    }
    // 시작 뒤 값이 고정되는 v 안의 키
    function quizFixedKeys() {
      return ['sid', 'half', 'seed', 'ver', 'bankVer', 'timeMult', 'noImage'];
    }
    // 열린 상태이고 시작 마감(열린 시각 + startDeadlineSec) 전인가
    function quizStartOpen() {
      let cfg = quizCfg();
      return cfg.get('stage', 'closed') == 'open'
          && request.time.toMillis() < cfg.get('openedAtMs', 0) + cfg.get('startDeadlineSec', 900) * 1000;
    }
    // 서버 시각이 시작 시각 + (제한 시간 × 배수 + 보전 + 추가 + 전체 정지 + 60초 유예) 안인가
    function quizWithinTime(sid) {
      let cfg = quizCfg();
      let b = quizV(resource);
      return request.time.toMillis() < resource.data.startedAt.toMillis()
          + (cfg.get('durationSec', 2400) * cfg.get('timeMult', {}).get(sid, 1)
             + b.get('pausedTotalSec', 0) + b.get('extraSec', 0) + cfg.get('pausedAccumSec', 0) + 60) * 1000;
    }
    // 이미 있던 블록 키는 바뀌지 않는다 (새 블록을 더하는 것만 허용)
    function quizBlocksKept() {
      let b = quizV(resource).get('blocks', {});
      return !quizV(request.resource).get('blocks', {}).diff(b).affectedKeys().hasAny(b.keys());
    }
    function quizServedKept() {
      let b = quizV(resource).get('served', {});
      return !quizV(request.resource).get('served', {}).diff(b).affectedKeys().hasAny(b.keys());
    }
    // 이벤트 목록은 앞부분이 그대로인 채 늘어나기만 한다 (arrayUnion 추가는 통과, 기존 항목 바꿔치기는 거부)
    function quizEventsGrow() {
      let before = quizV(resource).get('events', []);
      let after = quizV(request.resource).get('events', []);
      return after.size() >= before.size()
          && (before.size() == 0 || after[0:before.size()] == before);
    }
    // 경고 수·잠금 수는 줄지 않는다
    function quizCountersKept() {
      let b = quizV(resource);
      let a = quizV(request.resource);
      return a.get('warn', 0) >= b.get('warn', 0)
          && a.get('lock', {}).get('count', 0) >= b.get('lock', {}).get('count', 0);
    }
    // 잠금 시각은 그대로 두거나 서버 시각으로만 쓴다 (학생이 지난 시각을 꾸며 넣거나 지우지 못한다)
    function quizLockedAtOk() {
      let before = resource.data.get('lockedAt', null);
      let after = request.resource.data.get('lockedAt', null);
      return after == before || after == request.time;
    }
    match /quizBank/{docId} {
      allow read: if isTeacher() || (signedIn() && quizStage() != 'closed');
      allow write: if isTeacher();
    }
    match /quizKeys/{docId} {
      allow read, write: if isTeacher();
    }
    match /quiz/{sid} {
      allow read: if isOwner(sid) || isTeacher();
      allow delete: if isTeacher();
      allow create, update: if isTeacher();
      allow create: if isOwner(sid) && enrolled(sid)
                    && quizStartOpen()
                    && request.resource.data.startedAt == request.time
                    && !quizV(request.resource).keys().hasAny(quizTeacherKeys())
                    && quizV(request.resource).get('finishedAt', null) == null
                    && quizV(request.resource).get('sid', '') == sid
                    && quizV(request.resource).get('status', '') == 'running'
                    && quizV(request.resource).get('blocks', {}).size() == 0
                    && request.resource.data.get('lockedAt', null) == null;
      allow update: if isOwner(sid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v', 'hb', 'lockedAt', 'updatedAt'])
                    && request.resource.data.startedAt == resource.data.startedAt
                    && quizLockedAtOk()
                    && quizV(resource).get('finishedAt', null) == null
                    && !quizV(request.resource).diff(quizV(resource)).affectedKeys().hasAny(quizTeacherKeys())
                    && !quizV(request.resource).diff(quizV(resource)).affectedKeys().hasAny(quizFixedKeys())
                    && quizBlocksKept() && quizServedKept() && quizEventsGrow() && quizCountersKept()
                    && (quizWithinTime(sid)
                        || quizV(request.resource).diff(quizV(resource)).affectedKeys()
                             .hasOnly(['status', 'finishedAt', 'clientScore', 'events', 'lock', 'warn', 'cur']));
    }

    // 연구 참여 동의 대장: 교사만 읽고 쓴다.
    // 명부(students)에 두지 않는 이유 — 명부는 로그인한 학생 모두가 읽으므로
    // 누가 연구에서 빠졌는지가 학생끼리 보이게 된다. 동의 여부는 학생 사이에 드러나서는 안 된다.
    match /research/{docId} {
      allow read, write: if isTeacher();
    }

    // 그 밖의 학급 공용 문서. 「수업 편집」 탭이 고친 차시별 발문·이론·그림·링크가
    // lessonEdits 문서에 쌓인다. 학생은 읽기만 하고 교사만 고친다.
    match /misc/{docId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
